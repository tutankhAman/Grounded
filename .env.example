# Database & Cache
DATABASE_URL=postgresql://grounded:grounded@localhost:5432/grounded
REDIS_URL=redis://localhost:6379

# Server Ports
PORT=3000
VITE_API_URL=http://localhost:3000

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=100

# Parser & Chunking Tuning Thresholds (defaults shown)
# THRESHOLD_CHUNK_TOKEN_SPLIT=6000
# THRESHOLD_LOW_TEXT_CHARS=1000
# THRESHOLD_LOW_TEXT_MIN_ITEMS=15
# THRESHOLD_NUMERIC_RATIO=0.4
# THRESHOLD_SHORT_COL_WIDTH_RATIO=0.25

# LLM Providers
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=gpt-oss-120b
GEMINI_API_KEY=
VISION_MODEL=gemini-3.5-flash-lite
VISION_ENABLED=1

# Embedding & Vector Search
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=1536
FACT_TYPE_SIMILARITY_THRESHOLD=0.85
ENTITY_MATCH_THRESHOLD=0.80
