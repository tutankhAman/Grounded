# Database & Cache
DATABASE_URL=postgresql://grounded:grounded@localhost:5432/grounded
REDIS_URL=redis://localhost:6379

# Server Ports
PORT=3000
VITE_API_URL=http://localhost:3000

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=100

# Parser & Chunking Tuning Thresholds (defaults shown)
# THRESHOLD_CHUNK_TOKEN_SPLIT=6000
# THRESHOLD_LOW_TEXT_CHARS=1000
# THRESHOLD_LOW_TEXT_MIN_ITEMS=15
# THRESHOLD_NUMERIC_RATIO=0.4
# THRESHOLD_SHORT_COL_WIDTH_RATIO=0.25

# LLM Gateway & Provider Configuration
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
GEMINI_API_KEY=
TEXT_MODEL=gemini-3.5-flash-lite
TEXT_MODEL_FALLBACK=gemini-3.1-flash-lite
VISION_MODEL=gemini-3.5-flash-lite
THINKING_BUDGET=0
VISION_ENABLED=1
SKIP_BOILERPLATE=1
EXTRACT_CONCURRENCY=6
EXTRACT_TARGET_OUTPUT_TOKENS=14000
RESOLVE_CONCURRENCY=3
RENDER_SCALE=1.5
LLM_RPM_BUDGET=60

# Embedding & Vector Search (gemini-embedding-001 with explicit task_type and L2 normalization; never 002 for batches)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
EMBEDDING_TASK_DOC=RETRIEVAL_DOCUMENT
EMBED_DIRECT=0
FACT_TYPE_SIMILARITY_THRESHOLD=0.85
ENTITY_MATCH_THRESHOLD=0.80

# Fact Matching & Reconciliation (Phase 4)
MATCH_DISTANCE=0.35                   # pgvector cosine distance threshold (<=> operator); ~0.65 similarity
MATCH_CANDIDATES=10                   # nearest-neighbor cap per query fact
RECONCILE_CONCURRENCY=4               # parallel pair evaluations (judge calls) behind the global rate bucket
JUDGE_MODEL=                          # defaults to TEXT_MODEL (gemini-3.5-flash-lite); escalate only if explanations are thin
JUDGE_THINKING_BUDGET=0               # raise only if judge explanations are thin on starter PDFs
